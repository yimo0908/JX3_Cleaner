<Window x:Class="JX3Cleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:JX3Cleaner.App.Converters"
        xmlns:vm="clr-namespace:JX3Cleaner.App.ViewModels"
        xmlns:local="clr-namespace:JX3Cleaner.App"
        Title="剑网3 冗余数据清理" Height="800" Width="1180"
        MinHeight="580" MinWidth="960"
        FontFamily="Microsoft YaHei UI" Background="White" UseLayoutRounding="True">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />

        <!--
            展开箭头。系统默认的 TreeViewItem 模板会把选中态画成主题蓝（Aero2 里是静态画刷，
            改 SystemColors 覆盖不掉），所以整只模板自己写，行底色只由数据模板的 RowBackground 决定。
        -->
        <Style x:Key="TreeExpanderToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8 Z" Fill="#7A7A7A"
                                  Width="5" Height="8" Stretch="Fill"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <!--
                树里的行没有「选中」语义：状态一律由复选框表达。
                模板里刻意不引用 IsSelected，点组标题或任意行都不会出现蓝色背景，
                也不画焦点虚线框。
            -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <StackPanel Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Style="{StaticResource TreeExpanderToggle}"
                                              VerticalAlignment="Center" Margin="0,0,0,0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />

                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>

                            <ItemsPresenter x:Name="ItemsHost" Margin="19,0,0,0" />
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <!-- 叶子节点不画箭头，但保留占位宽度，避免标题左右跳动 -->
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemVm}" ItemsSource="{Binding Children}">
            <Border Background="{Binding RowBackground}" CornerRadius="6"
                    Padding="{Binding RowPadding}" Margin="{Binding RowMargin}"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="72" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsEnabled="{Binding IsSelectable}"
                              Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{Binding TitleFontSize}"
                                   FontWeight="{Binding TitleWeight}"
                                   Foreground="{Binding TitleBrush}" VerticalAlignment="Center" />

                        <!-- 已弃用分类（懒人插件 / 旧版团监）：黄色后缀 -->
                        <TextBlock Text="{Binding DeprecatedText}" FontSize="11"
                                   Foreground="{Binding DeprecatedBrush}"
                                   VerticalAlignment="Center" Margin="3,1,0,0"
                                   Visibility="{Binding HasDeprecated, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding RoleText}" FontSize="12" Foreground="#8C8C8C"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasRoles, Converter={StaticResource BoolToVis}}" />

                        <Border Background="#FFF4E5" CornerRadius="9" Padding="7,1" Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLegacy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="过期区服" FontSize="11" Foreground="#B26A00" />
                        </Border>

                        <Border Background="#F1EFE8" CornerRadius="9" Padding="7,1" Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="不完整" FontSize="11" Foreground="#5F5E5A" />
                        </Border>

                        <TextBlock Text="{Binding NoteText}" FontSize="11" Foreground="{Binding NoteBrush}"
                                   Margin="9,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />

                        <!-- 分类行的相对路径：灰色，点击在资源管理器打开；细项不显示 -->
                        <TextBlock Text="{Binding RelativePathText}" FontSize="11"
                                   Foreground="{Binding RelativePathBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Cursor="Hand" TextDecorations="Underline"
                                   ToolTip="点击在资源管理器中打开该目录"
                                   MouseLeftButtonUp="RelativePath_Click"
                                   Visibility="{Binding HasRelativePath, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11" Foreground="#8C8C8C"
                               VerticalAlignment="Center" Margin="12,0,4,0" />
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,0,0,1" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="客户端" FontSize="12" Foreground="#595959" VerticalAlignment="Center" />
                <Border Grid.Column="1" Margin="10,0" Background="White" BorderBrush="#E5E5E3"
                        BorderThickness="1" CornerRadius="6" Padding="9,5">
                    <TextBlock x:Name="PathBox" FontSize="12" FontFamily="Consolas" Foreground="#1F1F1F"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="未定位" />
                </Border>

                <TextBlock x:Name="StatusText" Grid.Column="2" Margin="12,0" FontSize="12" VerticalAlignment="Center"
                           Text="未定位" Foreground="#8C8C8C" />

                <Button Grid.Column="3" Content="设置" Padding="16,5" Margin="0,0,8,0" Click="OpenSettings_Click" />

                <Button x:Name="ScanButton" Grid.Column="4" Content="扫描" Padding="20,5" Click="Scan_Click"
                        Background="#1F1F1F" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>

        <TabControl x:Name="Pages" Grid.Row="1" Background="White" BorderThickness="0" Padding="0">
            <TabItem Header="数据清理">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="232" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12">
                            <StackPanel>
                                <TextBlock Text="数据类型" FontSize="12" FontWeight="Medium"
                                           Foreground="#595959" Margin="0,0,0,8" />
                                <StackPanel x:Name="FilterPanel" />

                                <Border Height="1" Background="#E5E5E3" Margin="0,14,0,14" />

                                <TextBlock Text="文件时间" FontSize="12" FontWeight="Medium"
                                           Foreground="#595959" Margin="0,0,0,7" />
                                <ComboBox x:Name="WindowBox" FontSize="12" SelectionChanged="WindowBox_SelectionChanged">
                                    <ComboBoxItem Content="全部" Tag="0" IsSelected="True" />
                                    <ComboBoxItem Content="只清理 7 天前" Tag="7" />
                                    <ComboBoxItem Content="只清理 30 天前" Tag="30" />
                                    <ComboBoxItem Content="只清理 90 天前" Tag="90" />
                                    <ComboBoxItem Content="只清理 180 天前" Tag="180" />
                                    <ComboBoxItem Content="只清理 365 天前" Tag="365" />
                                </ComboBox>

                                <!-- 时间筛选结果提示：有 N 项因时间范围被排除 -->
                                <TextBlock x:Name="FilterHintText" FontSize="11" Foreground="#8C8C8C"
                                           Margin="2,7,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                                <TextBlock Text="清理方式" FontSize="12" FontWeight="Medium"
                                           Foreground="#595959" Margin="0,16,0,7" />
                                <RadioButton x:Name="RecycleRadio" Content="移动到回收站（可还原）" FontSize="12"
                                             IsChecked="True" Margin="0,0,0,6" Checked="Mode_Checked" />
                                <RadioButton x:Name="DeleteRadio" Content="直接删除（cmd.exe del）" FontSize="12"
                                             Checked="Mode_Checked" />

                                <Border x:Name="DangerBanner" Background="#FDECEA" CornerRadius="6" Padding="9,7"
                                        Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="直接删除不进入回收站，删除后无法恢复。"
                                               FontSize="11" Foreground="#C62828" TextWrapping="Wrap" />
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="全选" Padding="0,5" Click="SelectAll_Click" />
                                    <Button Grid.Column="1" Content="全部取消" Padding="12,5"
                                            Margin="8,0,0,0" Click="ClearAll_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TreeView x:Name="DataTree" Grid.Column="1" BorderThickness="0" Padding="8,6"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False" />
                    </Grid>

                    <Border Grid.Row="1" Background="#FAFAF9" BorderBrush="#E5E5E3"
                            BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="SelectionText" FontSize="13" Foreground="#1F1F1F" Text="已选 0 项" />
                                <TextBlock x:Name="SelectionSubText" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button x:Name="CleanButton" Grid.Column="1" Content="开始清理" Padding="26,8" FontSize="13"
                                    Click="Clean_Click" Background="#1F1F1F" Foreground="White" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="截图与云图">
                <local:MediaBrowser x:Name="MediaPage" />
            </TabItem>
        </TabControl>

        <Grid x:Name="BusyOverlay" Grid.RowSpan="2" Background="#B3FFFFFF" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <TextBlock x:Name="BusyText" Text="正在扫描…" FontSize="13" Foreground="#1F1F1F" HorizontalAlignment="Center" />
                <ProgressBar x:Name="BusyBar" Height="6" Margin="0,12,0,0" IsIndeterminate="True" Foreground="#1F1F1F" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
