<UserControl x:Class="JX3Cleaner.App.MediaBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JX3Cleaner.App.Converters"
             xmlns:local="clr-namespace:JX3Cleaner.App"
             FontFamily="Microsoft YaHei UI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="VisWhenTrue" />
        <conv:BoolToVisibilityConverter x:Key="VisWhenFalse" Invert="True" />

        <!-- 单张卡片：176 + 左右各 6 外边距 = 188 一格（与 MediaBrowser.CellWidth 对应） -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Width="176" Height="166" Margin="6" Background="White"
                    BorderBrush="#E5E5E3" BorderThickness="1" CornerRadius="8"
                    Cursor="Hand" ToolTip="{Binding ToolTipText}"
                    Loaded="Card_Loaded"
                    MouseLeftButtonDown="Item_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="用系统默认应用打开" Click="OpenItem_Click" />
                        <MenuItem Header="打开所在路径" Click="OpenFolder_Click" />
                        <MenuItem Header="复制完整路径" Click="CopyPath_Click" />
                        <Separator />
                        <MenuItem Header="勾选此项" Click="CheckItem_Click" />
                        <MenuItem Header="取消勾选" Click="UncheckItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="118" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Background="#F1F0EC">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" />

                        <TextBlock Text="{Binding FallbackText}" FontSize="12" Foreground="#A8A7A2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource VisWhenFalse}}" />

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Background="#99000000" CornerRadius="4" Padding="5,1"
                                Visibility="{Binding IsVideo, Converter={StaticResource VisWhenTrue}}">
                            <TextBlock Text="▶ 视频" FontSize="10" Foreground="White" />
                        </Border>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                Background="#E6FFFFFF" CornerRadius="5" Padding="3,0,3,1">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Click="CardCheck_Click" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="7,4,7,3">
                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Foreground="#1F1F1F"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubText}" FontSize="10" Foreground="#8C8C8C" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#B9B8B3" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#1F1F1F" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 一行卡片。外层行由 VirtualizingStackPanel 虚拟化，行内才建卡片 -->
        <DataTemplate x:Key="CardRowTemplate">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CardTemplate}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="MonthHeaderTemplate">
            <Border Background="#F5F4F1" CornerRadius="6" Padding="10,7" Margin="6,8,6,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeaderText}" FontSize="13" FontWeight="SemiBold" Foreground="#1F1F1F" />
                    <TextBlock Text="{Binding HeaderSubText}" FontSize="11" Foreground="#8C8C8C"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:MediaRowTemplateSelector x:Key="RowSelector"
                                        HeaderTemplate="{StaticResource MonthHeaderTemplate}"
                                        RowTemplate="{StaticResource CardRowTemplate}" />
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,0,0,1" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton x:Name="ShotTab" Content="截图" Padding="16,4" FontSize="12"
                                  IsChecked="True" Click="ShotTab_Click" />
                    <ToggleButton x:Name="DcimTab" Content="幻境云图" Padding="16,4" FontSize="12"
                                  Margin="6,0,0,0" Click="DcimTab_Click" />
                </StackPanel>

                <TextBlock x:Name="DirText" Grid.Column="1" FontSize="11" Foreground="#9A9A9A"
                           VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="2" Content="全选" Padding="12,4" FontSize="12" Click="CheckAll_Click" />
                <Button Grid.Column="3" Content="全部取消" Padding="12,4" FontSize="12" Margin="6,0,0,0" Click="UncheckAll_Click" />
                <Button Grid.Column="4" Content="打开目录" Padding="12,4" FontSize="12" Margin="6,0,0,0" Click="OpenDir_Click" />
                <Button Grid.Column="5" Content="刷新" Padding="12,4" FontSize="12" Margin="6,0,0,0" Click="Refresh_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 时间导航 -->
            <Border Grid.Column="0" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="时间导航" FontSize="11" Foreground="#8C8C8C"
                               Margin="12,10,12,6" />

                    <ListBox x:Name="MonthList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="MonthList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource W11.ListItemCard}">
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="MonthItem_MouseUp" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="全选本月" Click="MonthCheckAll_Click" />
                                            <MenuItem Header="取消本月" Click="MonthUncheckAll_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Text="{Binding Display}" FontSize="12" Foreground="#1F1F1F" />
                                    <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#8C8C8C" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 缩略图网格：行级虚拟化，只实体化可视范围内的行 -->
            <Grid Grid.Column="1" x:Name="ContentHost" SizeChanged="ContentHost_SizeChanged">
                <ItemsControl x:Name="RowHost"
                              ItemTemplateSelector="{StaticResource RowSelector}"
                              BorderThickness="0"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="{x:Type ItemsControl}">
                            <ScrollViewer x:Name="RowScroll" CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="2,4,0,10">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint" Text="该目录下暂无图片或视频"
                           FontSize="13" Foreground="#A8A7A2"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- 底部：选中统计 + 清理 -->
        <Border Grid.Row="2" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,1,0,0" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelText" FontSize="13" Foreground="#1F1F1F" Text="已选 0 项" />
                    <TextBlock x:Name="SelSubText" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0"
                               Text="勾选缩略图左上角复选框后可清理" />
                </StackPanel>

                <TextBlock x:Name="CountText" Grid.Column="1" FontSize="11" Foreground="#8C8C8C"
                           VerticalAlignment="Center" Margin="0,0,18,0" Text="0 个文件" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="MediaRecycleRadio" Content="移动到回收站" FontSize="12"
                                 VerticalAlignment="Center" Checked="MediaMode_Checked" />
                    <RadioButton x:Name="MediaDeleteRadio" Content="直接删除" FontSize="12"
                                 Margin="14,0,0,0" VerticalAlignment="Center" Checked="MediaMode_Checked" />
                    <Button x:Name="MediaCleanButton" Content="清理选中" Margin="18,0,0,0" Padding="22,6"
                            FontSize="13" Click="MediaClean_Click"
                            Background="#1F1F1F" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
