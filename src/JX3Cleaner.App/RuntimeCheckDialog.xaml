<Window x:Class="JX3Cleaner.App.RuntimeCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行环境自检" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" Background="White" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 结论区 -->
        <Border Grid.Row="0" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,0,0,1"
                Padding="22,18,22,14">
            <StackPanel>
                <TextBlock Text="运行环境自检" FontSize="17" FontWeight="SemiBold" Foreground="#1F1F1F" />
                <TextBlock x:Name="HeadlineText" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="OneLineText" FontSize="11.5" Foreground="#8C8C8C" TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <!-- 问题列表 -->
        <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="22,16,16,4">
            <ItemsControl x:Name="IssueList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Width="7" Height="7" Fill="{Binding Marker}" VerticalAlignment="Top"
                                     Margin="0,6,9,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium"
                                           Foreground="#1F1F1F" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#6E6E6E"
                                           TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 操作区 -->
        <Border Grid.Row="2" Background="#FAFAF9" BorderBrush="#E5E5E3" BorderThickness="0,1,0,0"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CopyButton" Grid.Column="0" Content="复制诊断信息" Padding="14,6"
                        Click="Copy_Click" />

                <Button x:Name="DownloadButton" Grid.Column="1" HorizontalAlignment="Left" Padding="14,6"
                        Margin="10,0,0,0" Content="下载 .NET 桌面运行时" Click="Download_Click"
                        Visibility="Collapsed" />

                <Button x:Name="PrimaryButton" Grid.Column="2" Padding="26,7" FontSize="13"
                        Style="{StaticResource W11.PrimaryButton}" Click="Primary_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
