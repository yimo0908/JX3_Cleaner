<Window x:Class="JX3Cleaner.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" Background="White">
    <StackPanel Margin="22,18,22,16">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Medium" Foreground="#1F1F1F" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="#595959" TextWrapping="Wrap"
                   Margin="0,10,0,0" LineHeight="21" />
        <Border x:Name="AckPanel" Background="#FAFAF9" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
            <CheckBox x:Name="AckBox" FontSize="12.5" Foreground="#1F1F1F"
                      Checked="AckChanged" Unchecked="AckChanged" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" Padding="18,6" MinWidth="80" />
            <Button x:Name="OkButton" Content="确认" IsDefault="True" Padding="18,6" MinWidth="80"
                    Margin="10,0,0,0" Click="OkClick" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
